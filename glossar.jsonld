{
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar",
  "name": "Glossar der Generative Engine Optimization",
  "description": "Deutschsprachiges Glossar der Begriffe, die für Generative Engine Optimization gebraucht werden: KI-Antwortsysteme, Entitäten und strukturierte Daten, Zitierfähigkeit von Inhalten sowie das dafür nötige SEO-Fundament. 37 Begriffe mit kurzer Definition und Verweis auf die ausführliche Fassung.",
  "inLanguage": "de-DE",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "url": "https://github.com/taismo-gmbh/generative-engine-optimization-de",
  "publisher": {
    "@id": "https://taismo.de/#organization"
  },
  "hasDefinedTerm": [
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-agentic-seo",
      "name": "Agentic SEO",
      "description": "Agentic SEO bezeichnet den Einsatz autonomer KI-Agenten, die SEO-Aufgaben eigenständig planen, ausführen und laufend nachjustieren, von der Keyword-Recherche über die Content-Analyse bis zum technischen Monitoring. Anders als ein Chatbot, der auf jede einzelne Anweisung wartet, verfolgt ein Agent ein vorgegebenes Ziel selbstständig über viele Schritte hinweg. Strategie, Leitplanken und Freigabe bleiben beim Menschen.",
      "url": "https://taismo.de/was-ist/agentic-seo/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-ai-mode",
      "name": "AI Mode",
      "description": "Der AI Mode ist Googles KI-Suchmodus: Ein eigener Bereich der Google-Suche beantwortet Suchanfragen im Dialog statt mit einer Linkliste. Ein Modell aus der Gemini-Familie formuliert eine zusammenhängende Antwort, verlinkt die verwendeten Quellen und beantwortet Folgefragen im selben Gespräch. Google hat den AI Mode im März 2025 in den USA gestartet, seit Ende 2025 ist er auch in Deutschland nutzbar.",
      "url": "https://taismo.de/was-ist/ai-mode/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-ai-overviews",
      "name": "AI Overviews",
      "description": "AI Overviews sind KI-generierte Antwortblöcke, die Google ganz oben in den Suchergebnissen einblendet. Ein angepasstes Gemini-Modell fasst dafür Informationen aus mehreren Webquellen zu einer kurzen Übersicht zusammen und verlinkt die genutzten Seiten. Sie sind der produktive Nachfolger der Search Generative Experience (SGE) und werden in Deutschland seit März 2025 ausgespielt.",
      "url": "https://taismo.de/was-ist/ai-overviews/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-answer-engine-optimization",
      "name": "Answer Engine Optimization (AEO)",
      "description": "Answer Engine Optimization (AEO) ist die Optimierung von Inhalten, damit Antwortmaschinen sie direkt als Antwort ausspielen, etwa die Google AI Overviews, ChatGPT, Perplexity oder Sprachassistenten. Statt auf blaue Links in einer Trefferliste zielt AEO darauf, dass eine Maschine die Antwort selbst formuliert und dabei den eigenen Inhalt als Quelle nutzt. Der Fokus liegt auf direkten, klar strukturierten und zitierfähigen Antworten, die ein System ohne Umweg übernehmen kann.",
      "url": "https://taismo.de/was-ist/answer-engine-optimization/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-brand-mentions",
      "name": "Brand Mentions",
      "description": "Brand Mentions sind Erwähnungen einer Marke, eines Unternehmens oder eines Produkts auf fremden Websites und Plattformen, mit oder ohne Link. Besonders zählen die unverlinkten Erwähnungen, englisch linkless mentions: Sie zeigen Suchmaschinen und KI-Systemen, dass eine Marke existiert, in welchem Themenumfeld sie auftaucht und wie über sie gesprochen wird.",
      "url": "https://taismo.de/was-ist/brand-mentions/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-canonical-links",
      "name": "Canonical Links",
      "description": "Canonical Links sind HTML-Attribute im Kopfbereich einer Seite, die Suchmaschinen angeben, welche URL die primäre Quelle für einen Inhalt ist. Sie werden kurz auch Canonicals genannt. Sie verhindern, dass gleiche oder ähnliche Inhalte unter mehreren Adressen als Duplikate gewertet werden.",
      "url": "https://taismo.de/was-ist/canonical-links/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-crawler",
      "name": "Crawler",
      "description": "Ein Crawler ist ein Softwareprogramm, das das World Wide Web automatisiert durchsucht und daraus einen Index aufbaut. Er wird auch Web Crawler genannt und vor allem von Suchmaschinen eingesetzt. Beim Durchsuchen analysiert und indiziert er die Inhalte der Websites und legt damit die Grundlage für deren Auffindbarkeit.",
      "url": "https://taismo.de/was-ist/crawler/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-e-a-t",
      "name": "E-A-T",
      "description": "E-A-T steht für Expertise, Authoritativeness und Trustworthiness, auf Deutsch Expertise, Autorität und Vertrauenswürdigkeit. Das Konzept ist ein zentraler Bestandteil der Google-Richtlinien zur Bewertung von Seitenqualität und dient dazu, Qualität und Glaubwürdigkeit von Inhalten zu beurteilen.",
      "url": "https://taismo.de/was-ist/e-a-t/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-embedding",
      "name": "Embedding",
      "description": "Ein Embedding ist die Darstellung eines Inhalts als lange Zahlenreihe (Vektor), die seine Bedeutung mathematisch erfasst; eingebettet werden Wörter, Sätze, ganze Texte oder Bilder. Inhalte mit ähnlicher Bedeutung erhalten ähnliche Zahlenreihen und liegen im Vektorraum nahe beieinander. Suchmaschinen und KI-Systeme vergleichen Texte darüber nach Bedeutung statt nach Wortlaut.",
      "url": "https://taismo.de/was-ist/embedding/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-entitaet",
      "name": "Entität",
      "description": "Eine Entität ist ein eindeutig identifizierbares Ding oder Konzept, das eigenständig existiert und von allem anderen unterscheidbar ist, zum Beispiel eine Person, ein Ort, ein Unternehmen oder ein Produkt. Im SEO bezeichnet eine Entität einen solchen Knoten in Googles Knowledge Graph, der über eine eindeutige Kennung mit Eigenschaften und Beziehungen zu anderen Entitäten verknüpft ist.",
      "url": "https://taismo.de/was-ist/entitaet/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-gaio",
      "name": "GAIO",
      "description": "GAIO steht für Generative AI Optimization und bezeichnet die Optimierung von Inhalten für generative KI-Systeme wie ChatGPT, Perplexity und Googles KI-Antworten. Ziel ist, dass diese Systeme eine Marke oder Website in ihren Antworten nennen, zitieren und empfehlen. GAIO ist vor allem im deutschsprachigen Raum verbreitet und meint dasselbe wie der international etablierte Begriff Generative Engine Optimization (GEO).",
      "url": "https://taismo.de/was-ist/gaio/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-generative-engine-optimization",
      "name": "Generative Engine Optimization (GEO)",
      "description": "Generative Engine Optimization (GEO) bezeichnet die Optimierung von Inhalten und Entitäten, damit generative KI-Systeme wie ChatGPT, Google Gemini, Perplexity und die Google AI Overviews sie berücksichtigen und zitieren. GEO besteht aus vier Teilen: dem Aufbau der Entität, strukturierten Daten, zitierfähigen Inhalten und der Messung der KI-Sichtbarkeit. Sie überträgt die Prinzipien der Suchmaschinenoptimierung auf die KI-gestützte Suche und ersetzt sie nicht, denn eine Seite, die nicht rankt, wird auch nicht zitiert.",
      "url": "https://taismo.de/was-ist/generative-engine-optimization/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-grounding-page",
      "name": "Grounding Page",
      "description": "Eine Grounding Page ist eine einzelne, autoritative und maschinenlesbare Webseite, die als zitierfähige Faktenquelle zu genau einer Entität oder einem Thema dient. KI-Systeme wie ChatGPT, Google Gemini, Perplexity und die Google AI Overviews greifen im Grounding-Schritt auf sie zu, um ihre Antworten mit belegbaren Fakten abzusichern.",
      "url": "https://taismo.de/was-ist/grounding-page/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-hreflang",
      "name": "hreflang",
      "description": "hreflang ist ein HTML-Attribut, das Suchmaschinen die Sprache und die geografische Zielregion einer Webseite mitteilt. Es verknüpft inhaltsgleiche Seiten in verschiedenen Sprachen miteinander, damit Google jedem Nutzer die passende Sprach- oder Länderversion in den Suchergebnissen anzeigt.",
      "url": "https://taismo.de/was-ist/hreflang/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-indexierung",
      "name": "Indexierung",
      "description": "Indexierung bezeichnet die Aufnahme einer Webseite in den Google-Index, die durchsuchbare Datenbank der Suchmaschine. Nur indexierte Seiten können in den Suchergebnissen ranken. Davor durchläuft eine Seite zwei Schritte: das Crawling, bei dem Google sie findet und lädt, und das Rendering, bei dem Google sie inklusive JavaScript zusammenbaut.",
      "url": "https://taismo.de/was-ist/indexierung/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-interner-link",
      "name": "Interner Link",
      "description": "Ein interner Link ist ein Link, der auf eine andere Stelle der eigenen Webpräsenz zeigt. Externe Links verweisen dagegen auf Seiten außerhalb der eigenen Domain. Verweisen viele Stellen einer Website auf eine bestimmte Unterseite, wertet Google diese Seite als wichtiger.",
      "url": "https://taismo.de/was-ist/interner-link/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-json-ld",
      "name": "JSON-LD",
      "description": "JSON-LD (JavaScript Object Notation for Linked Data) ist ein leichtgewichtiges Format zur Strukturierung und Darstellung verknüpfter Daten. Es baut auf JSON auf und erweitert es um die Möglichkeit, Daten maschinenlesbar miteinander zu verknüpfen. Im SEO ist JSON-LD das übliche Format, um Auszeichnungen nach Schema.org in eine Seite einzubinden.",
      "url": "https://taismo.de/was-ist/json-ld/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-ki-crawler",
      "name": "KI-Crawler",
      "description": "KI-Crawler sind Programme, die Webseiten automatisiert abrufen, um Inhalte für KI-Systeme zu sammeln. Sie bedienen drei Zwecke: das Training von Sprachmodellen, den Suchindex von KI-Suchsystemen und den Live-Abruf einzelner Seiten während einer Nutzeranfrage. Bekannte KI-Crawler sind GPTBot und OAI-SearchBot von OpenAI, ClaudeBot von Anthropic und PerplexityBot.",
      "url": "https://taismo.de/was-ist/ki-crawler/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-ki-seo",
      "name": "KI-SEO",
      "description": "KI-SEO ist der Überbegriff für Suchmaschinenoptimierung rund um künstliche Intelligenz. Er umfasst zwei Arbeitsfelder: die Optimierung von Inhalten für KI-Suchsysteme wie ChatGPT, Perplexity und Googles KI-Antworten sowie den Einsatz von KI-Werkzeugen in der SEO-Arbeit selbst. Für das erste Feld stehen die Fachbegriffe GEO, LLMO und AEO.",
      "url": "https://taismo.de/was-ist/ki-seo/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-ki-suche",
      "name": "KI-Suche",
      "description": "KI-Suche bezeichnet Suchsysteme, die Anfragen mit generativer KI direkt beantworten, statt nur eine Liste von Links zu zeigen. Ein Sprachmodell fasst Inhalte aus dem Web zu einer zusammenhängenden Antwort zusammen und verlinkt die verwendeten Quellen. Zur KI-Suche zählen die AI Overviews und der AI Mode der Google-Suche, die ChatGPT-Suche, Perplexity und Gemini.",
      "url": "https://taismo.de/was-ist/ki-suche/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-knowledge-graph",
      "name": "Knowledge Graph",
      "description": "Der Knowledge Graph ist Googles Wissensdatenbank, die reale Dinge wie Personen, Orte, Organisationen und Konzepte als Entitäten speichert und über ihre Beziehungen miteinander verknüpft. Google nutzt ihn, um die Bedeutung hinter einer Suchanfrage zu verstehen, Knowledge Panels mit Fakten zu befüllen und KI-Antworten wie die AI Overviews abzusichern. Google nennt dieses Prinzip „things, not strings“.",
      "url": "https://taismo.de/was-ist/knowledge-graph/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-knowledge-panel",
      "name": "Knowledge Panel",
      "description": "Das Knowledge Panel ist die Infobox, die Google neben den Suchergebnissen einblendet und die Fakten zu einer eindeutig erkannten Entität bündelt: zu einer Person, einem Unternehmen, einem Ort oder einer Marke. Die Daten stammen aus dem Google Knowledge Graph. Ein Knowledge Panel lässt sich nicht buchen, es erscheint, wenn Google eine Entität sicher identifiziert und ihr genügend belegte Informationen zuordnen kann.",
      "url": "https://taismo.de/was-ist/knowledge-panel/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-llm",
      "name": "LLM",
      "description": "Ein LLM ist ein KI-Modell, das Sprache versteht und erzeugt. Die Abkürzung steht für Large Language Model, deutsch großes Sprachmodell: Das Modell wird mit riesigen Textmengen trainiert und berechnet zu einer Eingabe Wort für Wort die wahrscheinlichste Fortsetzung. LLMs sind die Technik hinter ChatGPT, Google Gemini und Claude und formulieren die Antworten der KI-Suche.",
      "url": "https://taismo.de/was-ist/llm/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-llmo",
      "name": "LLMO",
      "description": "LLMO (Large Language Model Optimization) ist die Optimierung von Inhalten und Entitäten, damit große Sprachmodelle wie ChatGPT, Gemini oder Perplexity sie verstehen, korrekt wiedergeben und als Quelle zitieren. LLMO sorgt dafür, dass eine Marke in den Antworten KI-basierter Assistenten auftaucht und nicht nur in der klassischen blauen Linkliste. Der Ansatz ist eng mit Generative Engine Optimization (GEO) verwandt.",
      "url": "https://taismo.de/was-ist/llmo/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-llms-txt",
      "name": "llms.txt",
      "description": "llms.txt ist eine Markdown-Datei im Web-Root einer Website, die großen Sprachmodellen und KI-Crawlern die wichtigsten Inhalte einer Seite und deren Struktur kuratiert bereitstellt. Ziel ist, dass Systeme wie ChatGPT, Claude oder Perplexity eine Website korrekt verstehen und ihre zentralen Seiten zuverlässig nutzen. Vorgeschlagen wurde das Format im September 2024 von Jeremy Howard, Mitgründer von Answer.AI.",
      "url": "https://taismo.de/was-ist/llms-txt/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-pillar-page",
      "name": "Pillar Page",
      "description": "Eine Pillar Page ist eine umfassende Hauptseite zu einem breiten Thema, die den kompletten Überblick gibt und auf vertiefende Cluster-Artikel verlinkt. Diese Cluster-Artikel behandeln einzelne Teilaspekte des Themas und verweisen ihrerseits zurück auf die Pillar Page. Zusammen bilden sie ein Themencluster, in dem die Pillar Page den zentralen Knoten darstellt.",
      "url": "https://taismo.de/was-ist/pillar-page/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-prompt",
      "name": "Prompt",
      "description": "Ein Prompt ist die Eingabe, mit der du ein KI-System zu einer Antwort aufforderst: eine Frage, eine Anweisung oder eine Aufgabenbeschreibung in natürlicher Sprache. ChatGPT, Gemini, Perplexity und ähnliche Systeme erzeugen ihre Ausgabe direkt aus diesem Prompt und dem darin enthaltenen Kontext. Für die Suche verschiebt das die Spielregeln: Prompts sind die neuen Suchanfragen.",
      "url": "https://taismo.de/was-ist/prompt/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-query-fan-out",
      "name": "Query Fan-Out",
      "description": "Query Fan-Out ist ein Verfahren der KI-Suche, bei dem ein System eine Suchanfrage in mehrere Teilfragen zerlegt, diese Teilfragen gleichzeitig gegen einen Suchindex laufen lässt und die Treffer zu einer einzigen Antwort zusammenführt. Google setzt Query Fan-Out im AI Mode und in den AI Overviews ein. Weil jede Teilfrage eine eigene Suche auslöst, entscheidet die Abdeckung dieser Teilfragen darüber, welche Seiten in der KI-Antwort als Quelle erscheinen.",
      "url": "https://taismo.de/was-ist/query-fan-out/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-retrieval-augmented-generation",
      "name": "Retrieval Augmented Generation (RAG)",
      "description": "Retrieval Augmented Generation (RAG) ist eine KI-Architektur, die ein großes Sprachmodell mit einem vorgeschalteten Abruf-Schritt kombiniert. Vor der Antwortgenerierung werden relevante Informationen aus einer externen Wissensquelle abgerufen und dem Modell als Kontext mitgegeben. RAG reduziert dadurch Halluzinationen und ist die Grundlage vieler KI-Suchsysteme wie Perplexity und der Google AI Overviews.",
      "url": "https://taismo.de/was-ist/retrieval-augmented-generation/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-robots-txt",
      "name": "robots.txt",
      "description": "Die robots.txt ist eine Textdatei auf einem Webserver, die nach dem Robots-Exclusion-Standard-Protokoll aufgebaut ist. Sie enthält Anweisungen an Crawler, welche Bereiche einer Website sie abrufen sollen. Die Anweisungen sind eine Empfehlung und keine technische Sperre: Große Suchmaschinen haben sich 2008 darauf geeinigt, sie zu befolgen, eine Garantie dafür gibt es nicht.",
      "url": "https://taismo.de/was-ist/robots-txt/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-schema-org",
      "name": "Schema.org",
      "description": "Schema.org ist ein gemeinsames, von Google, Bing, Yahoo und Yandex getragenes Vokabular für strukturierte Daten. Es definiert standardisierte Typen und Eigenschaften, etwa Product, Article oder FAQPage, mit denen eine Webseite die Bedeutung ihrer Inhalte für Suchmaschinen und KI-Systeme maschinenlesbar auszeichnet. Umgesetzt wird Schema.org meist über das Format JSON-LD.",
      "url": "https://taismo.de/was-ist/schema-org/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-semantische-suche",
      "name": "Semantische Suche",
      "description": "Semantische Suche bezeichnet Suchverfahren, die die Bedeutung einer Suchanfrage interpretieren, statt nur ihren Wortlaut mit Dokumenten abzugleichen. Google erkennt dafür Entitäten, ihre Zusammenhänge und die Suchintention hinter der Anfrage und liefert Ergebnisse, die die Frage beantworten, auch wenn sie andere Wörter verwenden. Semantische Suche ist die Grundlage der modernen Google-Suche und der KI-Suche.",
      "url": "https://taismo.de/was-ist/semantische-suche/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-strukturierte-daten",
      "name": "Strukturierte Daten",
      "description": "Strukturierte Daten sind Daten, die einem festgelegten, maschinenlesbaren Format folgen und deshalb von Programmen zuverlässig verarbeitet werden können. Im Web bezeichnet der Begriff das Markup, das einer Seite hinzugefügt wird, um Suchmaschinen und KI-Systemen genauere Informationen über ihren Inhalt zu liefern. Gängige Formate dafür sind Schema.org, RDFa, Microdata und JSON-LD.",
      "url": "https://taismo.de/was-ist/strukturierte-daten/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-suchintention",
      "name": "Suchintention",
      "description": "Suchintention ist das Ziel, das jemand mit einer Suchanfrage verfolgt, also warum ein bestimmtes Keyword eingegeben wird und welche Art von Antwort erwartet wird. Es gibt vier Haupttypen: informational, navigational, transaktional und kommerziell. Wer die Suchintention hinter einem Keyword trifft, liefert genau den Inhalt, den der Suchende sucht.",
      "url": "https://taismo.de/was-ist/suchintention/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-themencluster",
      "name": "Themencluster",
      "description": "Ein Themencluster ist ein Verbund aus einer zentralen Pillar Page und mehreren Detail-Artikeln, die untereinander verlinkt sind und ein Thema gemeinsam vollständig abdecken. Die Pillar Page behandelt das Hauptthema in der Breite, jeder Cluster-Artikel beantwortet eine Teilfrage in der Tiefe. Die interne Verlinkung macht den Zusammenhang für Suchmaschinen und KI-Systeme erkennbar.",
      "url": "https://taismo.de/was-ist/themencluster/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-topical-authority",
      "name": "Topical Authority",
      "description": "Topical Authority ist die Kompetenz, die eine Website zu einem bestimmten Themengebiet in den Augen von Suchmaschinen und KI-Systemen besitzt. Sie entsteht durch umfassende, tiefe und intern vernetzte Inhalte, die ein Thema vollständig abdecken. Je lückenloser eine Website ein Thema behandelt, desto eher gilt sie als verlässliche Quelle.",
      "url": "https://taismo.de/was-ist/topical-authority/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#begriff-zero-click-search",
      "name": "Zero-Click-Search",
      "description": "Zero-Click-Search bezeichnet eine Suchanfrage, deren Antwort direkt auf der Suchergebnisseite erscheint, sodass niemand mehr auf ein organisches Ergebnis klickt. Ausgelöst wird sie von SERP-Features wie Featured Snippets, Knowledge Panels und AI Overviews, die die gesuchte Information sofort anzeigen. Die Suchreise endet damit auf der Ergebnisseite selbst und nicht auf einer externen Website.",
      "url": "https://taismo.de/was-ist/zero-click-search/",
      "inDefinedTermSet": {
        "@id": "https://github.com/taismo-gmbh/generative-engine-optimization-de#glossar"
      }
    }
  ]
}
